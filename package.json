{
  "name": "talkon-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TalkON - Production-grade WhatsApp-equivalent messaging platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migrate": "npm run migrate --workspace=packages/backend-auth",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "turbo": "^1.12.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/talkon.git"
  },
  "keywords": [
    "messaging",
    "chat",
    "e2ee",
    "real-time",
    "websocket",
    "whatsapp-clone"
  ],
  "author": "TalkON Team",
  "license": "AGPL-3.0"
}
