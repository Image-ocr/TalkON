# TalkON Web App - Environment Variables
# Copy this file to .env.local for local development
# These variables are NOT committed to Git

# ============================================
# PUBLIC VARIABLES (exposed to browser)
# ============================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Feature Flags
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_GROUPS=true

# ============================================
# PRIVATE VARIABLES (server-only)
# ============================================

# These are only available in API routes and server components
# Do NOT prefix with NEXT_PUBLIC_

# API Keys (if needed for server-side API calls)
# API_SECRET_KEY=your-secret-key-here
